interrupt [USART_RXC] void usart_rx_isr(void)
{
//    if (RXCIE0 && RXC0)
    {        
        buff_rx[length_rx] = UDR0;       
        if((UCSR0A & (1<<RXC0))==0)    //(UCSRA.7==0)      
        {  
            if ((buff_rx[0] == diaChiSlave) || (buff_rx[0] == 0x00))
            {   
//                send("vao modbus ok!\r\n");
                if (length_rx == 1)
                    function_code = buff_rx[1]; 

                if (length_rx == 6 && function_code == 0x10)
                {   
//                    send("length=6?\r\n"); 
                    address_register1 = buff_rx[3];    //dia chi thanh ghi dau tien
                    number_status1 = buff_rx[5];   //so word
                    number_byte1 = buff_rx[6];   //so byte ghi vao vung nho
                }   
                else if (length_rx == 5 && function_code == 0x03)
                {   
                    address_register1 = buff_rx[3];    //dia chi thanh ghi dau tien
                    number_status1 = buff_rx[5];   //so word
                }                                          
                            
                if (length_rx == 8 + number_byte1 && function_code == 0x10 && address_register1 == 0x0A )   //phan hoi ghi realtime va addr slave
                { 
//                    send("Fx=10?");  
                    CRC16 = CRC_Check(&buff_rx[0],length_rx-1);
                    if (( buff_rx[length_rx-1] == ((unsigned char *)&CRC16)[0] ) && (buff_rx[length_rx] = ((unsigned char *)&CRC16)[1] )) 
                        F_rx = 10;
                }
                else if (length_rx == 7 && function_code == 0x03 && (address_register1 == 0x15 || address_register1 == 0x29))  //doc data may 1 hoac may 2
                {
                    CRC16 = CRC_Check(&buff_rx[0],length_rx-1);
                    if (( buff_rx[length_rx-1] == ((unsigned char *)&CRC16)[0] ) && (buff_rx[length_rx] = ((unsigned char *)&CRC16)[1] )) 
                        F_rx = 3;
                }
                else 
                    F_rx = 0;
            }    
            length_rx ++;
        }
        UCSR0A=(0<<RXC0);    //Xoa co nhan   //UCSRA.7=0;  
    }
}


void epprom_write(unsigned int add, unsigned char data)
{
    while(EECR & (1<<EEPE));
    EEAR=add;
    EEDR=data;
    EECR=(1<<EEMPE);
    EECR|=(1<<EEPE);
}

unsigned char epprom_read(unsigned int add)
{
    while(EECR & (1<<EEPE));
    EEAR=add;
    EECR|=(1<<EERE);
    return EEDR; 
} 


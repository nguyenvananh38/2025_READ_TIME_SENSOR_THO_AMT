unsigned int CRC_Check(unsigned char *Buf_Crc, unsigned char Length)
{
    unsigned int Crc_Temp = 0xFFFF;
    unsigned char Crc0_Index, Crc1_Index;
    for (Crc0_Index = 0; Crc0_Index < Length; Crc0_Index++)
    {
        Crc_Temp = Crc_Temp ^ *Buf_Crc;          // XOR byte into least sig. byte of crc
        for (Crc1_Index = 8; Crc1_Index != 0; Crc1_Index--)
        {    // Loop over each bit
            if ((Crc_Temp & 0x0001) != 0)
            {      // If the LSB is set
                Crc_Temp >>= 1;                    // Shift right and XOR 0xA001
                Crc_Temp ^= 0xA001;
            }
            else                            // Else LSB is not set
                Crc_Temp >>= 1;                    // Just shift right
        }
        Buf_Crc++;
    }
    return Crc_Temp;
}

